# MiniUnicorn Docker Compose 环境变量
# 复制本文件为 .env 后修改,或直接 export 对应变量

# WebUI 访问端口(宿主机端口)
WEBUI_PORT=8765

# OpenAI 兼容 API 端口(仅绑定到 127.0.0.1,不对外暴露)
API_PORT=8900

# 配置目录(宿主机路径,挂载到容器内 /home/miniunicorn/.miniunicorn)
# 默认为 ~/.miniunicorn,可改为自定义路径以隔离多个实例
# MINIUNICORN_CONFIG=~/.miniunicorn

# 运行时模式(设计 §9.2,§27,WP8 task 5):
#   轻量模式(默认):1 CPU / 1 GiB / 200 PID,适用于单槽位。
#     docker compose up -d miniunicorn-gateway
#   监督模式:2 CPU / 2 GiB / 512 PID,匹配 3 个 Worker 的默认配置。
#     需在配置文件中设置 runtime.mode=supervised,然后:
#     docker compose --profile supervised up -d miniunicorn-gateway-supervised
#   监督模式启动 Control Plane + N 个 Worker 子进程,停机宽限 75s
#   以覆盖 runtime.shutdownGraceS(默认 60s)+ 子进程树终止时间。
