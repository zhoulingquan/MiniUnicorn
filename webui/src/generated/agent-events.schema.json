    "FileEditEvent": {
      "additionalProperties": false,
      "description": "Batched file-edit notification (one or more edits).",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "string"
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/FileEditPayload"
          },
          "title": "Edits",
          "type": "array"
        },
        "event": {
          "const": "file_edit",
          "default": "file_edit",
          "title": "Event",
          "type": "string"
        },
