          "type": "string"
        }
      },
      "required": [
        "chat_id",
        "status"
      ],
      "title": "GoalStatusEvent",
      "type": "object"
    },
    "MessageEvent": {
      "additionalProperties": false,
      "description": "Conversational assistant message (final or intermediate breadcrumb).\n\n``kind`` disambiguates intermediate breadcrumbs (``tool_hint`` /\n``progress`` / ``reasoning``) from final replies, which omit the field.",
      "properties": {
        "agent_ui": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Ui"
        },
        "chat_id": {
          "title": "Chat Id",
          "type": "string"
        },
        "event": {
          "const": "message",
          "default": "message",
          "title": "Event",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "tool_hint",
                "progress",
                "reasoning"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "media": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media"
        },
        "media_urls": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Urls"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "reply_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply To"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tool_events": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolProgressEvent"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Events"
        }
      },
      "required": [
        "chat_id",
        "text"
      ],
      "title": "MessageEvent",
      "type": "object"
    },
    "ReadyEvent": {
      "additionalProperties": false,
