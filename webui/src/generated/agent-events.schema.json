          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        }
      },
      "required": [
        "chat_id",
        "edits"
      ],
      "title": "FileEditEvent",
      "type": "object"
    },
    "FileEditPayload": {
      "additionalProperties": false,
      "description": "One file-edit event emitted by editing tools.",
      "properties": {
        "absolute_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute Path"
        },
        "added": {
          "default": 0,
          "minimum": 0,
          "title": "Added",
          "type": "integer"
        },
        "approximate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approximate"
        },
        "binary": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binary"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "deleted": {
          "default": 0,
          "minimum": 0,
          "title": "Deleted",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "operation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "pending": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "status": {
          "enum": [
            "editing",
            "done",
            "error"
          ],
