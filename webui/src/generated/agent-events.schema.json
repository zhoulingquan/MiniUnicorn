        "stream_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Id"
        }
      },
      "required": [
        "chat_id"
      ],
      "title": "ReasoningEndEvent",
      "type": "object"
    },
