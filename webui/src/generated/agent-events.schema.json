          "title": "Phase",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "phase",
        "call_id",
        "name"
      ],
      "title": "ToolProgressEvent",
      "type": "object"
    },
