{
  "$defs": {
    "AttachedEvent": {
      "additionalProperties": false,
      "description": "Ack for ``new_chat`` / ``attach`` envelopes.",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "string"
        },
        "event": {
          "const": "attached",
          "default": "attached",
          "title": "Event",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        }
      },
      "required": [
        "chat_id"
      ],
      "title": "AttachedEvent",
      "type": "object"
    },
    "ContextUsagePayload": {
      "additionalProperties": false,
      "description": "Token-usage snapshot for a completed turn.",
      "properties": {
        "cached_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "ContextUsagePayload",
      "type": "object"
    },
    "DeltaEvent": {
      "additionalProperties": false,
      "description": "One streaming text chunk for the active assistant bubble.",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "string"
        },
        "event": {
          "const": "delta",
          "default": "delta",
          "title": "Event",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "stream_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "chat_id",
        "text"
      ],
      "title": "DeltaEvent",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
