        }
      },
      "required": [
        "active"
      ],
      "title": "GoalStatePayload",
      "type": "object"
    },
    "GoalStatusEvent": {
      "additionalProperties": false,
      "description": "Wall-clock hint that a turn started or finished.",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "string"
        },
        "event": {
          "const": "goal_status",
          "default": "goal_status",
