        "call_id",
        "tool",
        "path",
        "status"
      ],
      "title": "FileEditPayload",
      "type": "object"
    },
    "GoalStateEvent": {
      "additionalProperties": false,
      "description": "Persisted goal-state snapshot pushed to freshly subscribed clients.",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "string"
        },
        "event": {
          "const": "goal_state",
          "default": "goal_state",
          "title": "Event",
          "type": "string"
        },
        "goal_state": {
          "$ref": "#/$defs/GoalStatePayload"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        }
      },
      "required": [
        "chat_id",
        "goal_state"
      ],
      "title": "GoalStateEvent",
      "type": "object"
    },
    "GoalStatePayload": {
      "additionalProperties": false,
      "description": "Persisted sustained-goal snapshot replayed on reconnect.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "objective": {
          "anyOf": [
