      "additionalProperties": false,
      "description": "One tool-call lifecycle breadcrumb.\n\nThis is both a standalone event payload (embedded in ``MessageEvent``)\nand the shape persisted in the WebUI transcript for tool-call traces.\n``version`` is fixed at ``1`` for this protocol generation.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "embeds": {
          "items": {},
          "title": "Embeds",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
